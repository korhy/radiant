{# templates/components/_app_detail_drawer.html.twig

   The dialog comes from the shadcn kit (`Dialog`), built on the native
   `<dialog>` element: focus trap, Escape, inert background and focus
   restoration are the browser's job, no longer hand-written JavaScript. All the
   `app-detail-drawer` controller keeps is the tab bar.

   `Dialog:Content` is a centred modal by default; the classes passed here pull
   it back to the right edge, as a full-height drawer. They are merged by
   `tailwind_merge`, not concatenated, so they do override the kit's. #}
{% if app_detail is defined and app_detail is not null %}
    {# `data-controller` is merged by the component, not overwritten: pass only
       the tabs controller, `dialog` being added by the kit. #}
    <twig:Dialog id="app-detail" data-controller="app-detail-drawer">
        <twig:block name="content">
            <button
                type="button"
                data-action="click->dialog#open"
                data-dialog-target="trigger"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label="Ouvrir les coulisses de cette application"
                class="fixed bottom-6 right-6 z-50 bg-brand hover:bg-brand-strong text-brand-on rounded-full p-3 shadow-lg transition-colors {{ hide_drawer_btn_on_mobile is defined and hide_drawer_btn_on_mobile ? 'hidden md:block' : '' }}"
            >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
                </svg>
            </button>

            <twig:Dialog:Content
                :showCloseButton="false"
                class="top-0 bottom-0 left-auto right-0 h-full w-96 max-w-full sm:max-w-full translate-x-full translate-y-0 scale-100 rounded-none border-0 border-l p-0 gap-0 shadow-2xl open:flex flex-col open:translate-x-0 open:scale-100 starting:open:translate-x-full starting:open:scale-100"
            >
                <twig:block name="content">
                    <twig:Dialog:Header class="flex-row items-center justify-between gap-0 border-b px-6 py-4 text-left shrink-0">
                        <twig:block name="content">
                            <twig:Dialog:Title class="flex items-center gap-2 text-base font-bold tracking-wide">
                                <twig:block name="content">
                                    <svg class="w-4 h-4 text-brand-fg-em" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="m6.75 7.5 3 2.25-3 2.25m4.5 0h3m-9 8.25h13.5A2.25 2.25 0 0 0 21 18V6a2.25 2.25 0 0 0-2.25-2.25H5.25A2.25 2.25 0 0 0 3 6v12a2.25 2.25 0 0 0 2.25 2.25Z" />
                                    </svg>
                                    Behind the scenes
                                </twig:block>
                            </twig:Dialog:Title>
                            <button
                                type="button"
                                data-action="click->dialog#close"
                                aria-label="Fermer les coulisses"
                                class="text-content-low hover:text-content-max transition-colors"
                            >
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                                </svg>
                            </button>
                        </twig:block>
                    </twig:Dialog:Header>

                    <div class="flex border-b shrink-0" role="tablist" aria-label="Coulisses">
                        {% for tab in [
                            {key: 'stack', label: 'Présentation'},
                            {key: 'challenges', label: 'Défis'},
                            {key: 'improvements', label: 'À venir'},
                            {key: 'resources', label: 'Ressources'},
                        ] %}
                            <button type="button" role="tab" id="app-detail-tab-{{ tab.key }}"
                                aria-controls="app-detail-panel-{{ tab.key }}" aria-selected="false" tabindex="-1"
                                data-app-detail-drawer-target="tab" data-tab="{{ tab.key }}"
                                data-action="click->app-detail-drawer#switchTab keydown->app-detail-drawer#moveTab"
                                class="flex-1 py-3 text-xs font-medium transition-colors">
                                {{ tab.label }}
                            </button>
                        {% endfor %}
                    </div>

                    <div class="flex-1 overflow-y-auto overscroll-contain px-6 py-5">
                        <div role="tabpanel" id="app-detail-panel-stack" aria-labelledby="app-detail-tab-stack" tabindex="0"
                            data-app-detail-drawer-target="panel" data-tab="stack">
                            {% if app_detail.description %}
                                <twig:Dialog:Description class="mb-4 leading-relaxed">
                                    <twig:block name="content">{{ app_detail.description }}</twig:block>
                                </twig:Dialog:Description>
                            {% endif %}
                            {% if app_detail.techStack %}
                                {% set categories = {} %}
                                {% for item in app_detail.techStack %}
                                    {% set cat = item.category ?? 'Autre' %}
                                    {% set categories = categories|merge({(cat): (categories[cat] ?? [])|merge([item.name])}) %}
                                {% endfor %}
                                <div class="flex flex-col gap-4">
                                    {% for category, items in categories %}
                                        <div>
                                            <p class="text-content-min text-xs uppercase tracking-wider mb-2">{{ category }}</p>
                                            <div class="flex flex-wrap gap-2">
                                                {% for item in items %}
                                                    <span class="bg-surface-inset text-brand-fg-em text-xs px-3 py-1 rounded-full border border-brand-light">{{ item }}</span>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-content-min text-sm">Aucune information pour l'instant.</p>
                            {% endif %}
                        </div>

                        <div role="tabpanel" id="app-detail-panel-challenges" aria-labelledby="app-detail-tab-challenges" tabindex="0"
                            data-app-detail-drawer-target="panel" data-tab="challenges" class="hidden">
                            {% if app_detail.challenges %}
                                <div class="flex flex-col gap-4">
                                    {% for item in app_detail.challenges %}
                                        <div class="border-l-2 border-brand-light pl-4">
                                            <p class="text-content-max text-sm font-medium mb-1">{{ item.title }}</p>
                                            <p class="text-content-low text-sm leading-relaxed">{{ item.description }}</p>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-content-min text-sm">Aucune information pour l'instant.</p>
                            {% endif %}
                        </div>

                        {# Stored rows carry only a `description`; the title stays optional rather than
                           removed, so a row that later gains one renders without touching this
                           template. #}
                        <div role="tabpanel" id="app-detail-panel-improvements" aria-labelledby="app-detail-tab-improvements" tabindex="0"
                            data-app-detail-drawer-target="panel" data-tab="improvements" class="hidden">
                            {% if app_detail.improvements %}
                                <ul class="flex flex-col gap-3">
                                    {% for item in app_detail.improvements %}
                                        <li class="flex items-start gap-3">
                                            <span class="mt-1 w-2 h-2 rounded-full bg-brand-light shrink-0" aria-hidden="true"></span>
                                            <div>
                                                {% if item.title is defined and item.title %}
                                                    <p class="text-content-max text-sm font-medium">{{ item.title }}</p>
                                                {% endif %}
                                                {% if item.description is defined and item.description %}
                                                    <p class="text-content-low text-sm leading-relaxed">{{ item.description }}</p>
                                                {% endif %}
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% else %}
                                <p class="text-content-min text-sm">Aucune information pour l'instant.</p>
                            {% endif %}
                        </div>

                        {# Ressources #}
                        <div role="tabpanel" id="app-detail-panel-resources" aria-labelledby="app-detail-tab-resources" tabindex="0"
                            data-app-detail-drawer-target="panel" data-tab="resources" class="hidden">
                            {% if app_detail.resources %}
                                <div class="flex flex-col gap-2">
                                    {% for item in app_detail.resources %}
                                        <a href="{{ item.url }}" target="_blank" rel="noopener noreferrer"
                                            class="flex items-center gap-3 bg-surface-inset hover:bg-surface-muted rounded-lg px-4 py-3 transition-colors group">
                                            <svg class="w-4 h-4 text-content-low group-hover:text-brand-fg-em transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244" />
                                            </svg>
                                            <span class="text-content text-sm group-hover:text-content-max transition-colors">{{ item.label }}</span>
                                            <svg class="w-3 h-3 text-content-min group-hover:text-content-mid ml-auto transition-colors shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                                            </svg>
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-content-min text-sm">Aucune information pour l'instant.</p>
                            {% endif %}
                        </div>
                    </div>
                </twig:block>
            </twig:Dialog:Content>
        </twig:block>
    </twig:Dialog>
{% endif %}
