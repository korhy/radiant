{# @prop recipe array The recipe to render, as served by the Cookbook list endpoint (see specs/005-cookbook-card-component/data-model.md) #}
{%- props recipe -%}
<a
    href="{{ path('cookbook_recipe', {id: recipe.id}) }}"
    data-slot="recipe-card"
    class="{{ ('group bg-surface-raised rounded-2xl overflow-hidden shadow-lg hover:shadow-brand/10 hover:-translate-y-1 transition-all duration-200 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes }}
>
    {# The title sits inside the link, so the thumbnail is decorative: an alt
       repeating it would have the link announced twice. #}
    {% if recipe.thumbnail is defined and recipe.thumbnail %}
        <img src="{{ recipe.thumbnail }}" alt="" data-slot="recipe-card-media"
            class="w-full h-40 object-cover group-hover:brightness-110 transition-all duration-200">
    {% else %}
        <div data-slot="recipe-card-media" class="w-full h-40 bg-surface-inset flex items-center justify-center">
            <span class="w-10 h-10 text-content-min">
                {{ include('components/_icon_cookbook.html.twig') }}
            </span>
        </div>
    {% endif %}

    <div data-slot="recipe-card-content" class="p-4 flex flex-col gap-2">
        <h2 data-slot="recipe-card-title"
            class="text-content-max font-semibold text-sm leading-snug group-hover:text-brand-fg-em transition-colors">
            {{ recipe.title }}
        </h2>
        <div data-slot="recipe-card-meta" class="flex items-center gap-2 flex-wrap mt-auto">
            {% if recipe.category is defined and recipe.category %}
                <twig:Badge class="bg-brand/20 text-brand-fg-em">{{ recipe.category.name }}</twig:Badge>
            {% endif %}
            {% if recipe.duration is defined and recipe.duration %}
                <span class="text-content-low text-xs flex items-center gap-1 ml-auto">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="10" />
                        <path d="M12 6v6l4 2" />
                    </svg>
                    {{ recipe.duration }} min
                </span>
            {% endif %}
        </div>
    </div>
</a>
