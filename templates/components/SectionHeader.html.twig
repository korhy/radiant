{# @prop title string The section label. #}
{#
   The header of a portfolio section, in its two forms:
   — below `lg`, a sticky bar following the scroll;
   — from `lg` up, a plain label above the list, the side navigation taking over
     from the bar.

   The `h2` stays in the accessibility tree at both sizes; the desktop label only
   repeats it on screen, hence its `aria-hidden`.
#}
{%- props title -%}
<div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-surface/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
    <h2 class="text-xs font-bold uppercase tracking-widest text-content-min lg:sr-only">{{ title }}</h2>
</div>
<p class="mb-3 hidden text-xs font-bold uppercase tracking-widest text-content-min lg:block" aria-hidden="true">{{ title }}</p>
