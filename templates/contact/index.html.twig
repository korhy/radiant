{% extends 'base.html.twig' %}

{% block title %}Me contacter — Clément BOUDINEL{% endblock %}

{% block body %}
    <section class="align-middle">
        <div class="flex flex-col items-center justify-center px-2 py-8 mx-auto md:h-screen lg:py-0">
            <div class="w-full bg-panel border border-panel-line rounded-lg shadow-sm md:mt-0 xl:p-0">
                <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                    <h1 class="text-xl font-bold leading-tight tracking-tight text-content-max md:text-2xl">
                        Me contacter !
                    </h1>
                    {{ form_start(form) }}
                    {# form_row applies the configured tailwind_2_layout theme and renders
                       form_errors: wiring the fields by hand bypassed both, and a rejected
                       message vanished without showing anything. #}
                    {# The tailwind_2_layout theme renders fields with no border and no
                       background: hand it back the classes used across the site, or the
                       input loses its affordance and its outline falls below the required
                       contrast (WCAG 1.4.11). #}
                    {% set label_class = 'block mb-2 text-sm font-medium text-content-max' %}
                    {% set input_class = 'bg-field border border-field-line text-field-content placeholder-field-hint sm:text-sm rounded-lg focus:ring-brand-fg focus:border-brand-fg block w-full p-2.5' %}

                    <div id="contact" class="flex flex-col gap-6">
                        {{ form_row(form.name, {label_attr: {class: label_class}, attr: {class: input_class, spellcheck: 'false'}}) }}
                        {{ form_row(form.email, {label_attr: {class: label_class}, attr: {class: input_class}}) }}
                        {{ form_row(form.message, {label_attr: {class: label_class}, attr: {class: input_class, rows: 5}}) }}
                    </div>
                    <div class="flex items-center justify-between gap-4">
                        <a class="w-1/5 text-neutral-on bg-neutral hover:bg-neutral-strong focus:ring-4 focus:outline-hidden focus:ring-brand-fg focus:ring-offset-2 focus:ring-offset-panel font-medium rounded-lg text-sm px-5 py-2.5 text-center"
                            href="{{ path('homepage') }}"
                        >
                            Annuler
                        </a>
                        {{ form_widget(form.submit, {
                            attr: {class: 'w-3/5 text-brand-on bg-brand-strong hover:bg-brand focus:ring-4 focus:outline-hidden focus:ring-brand-fg focus:ring-offset-2 focus:ring-offset-panel font-medium rounded-lg text-sm px-5 py-2.5 text-center'},
                        }) }}
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
