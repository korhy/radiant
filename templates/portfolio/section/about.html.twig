{% if about_segments is not empty %}
    <section id="about" class="mb-8 scroll-mt-16 md:mb-24 lg:mb-26 lg:scroll-mt-24" aria-label="About me">
        <div class="sticky top-0 z-20 -mx-6 mb-4 w-screen bg-surface/75 px-6 py-5 backdrop-blur md:-mx-12 md:px-12 lg:sr-only lg:relative lg:top-auto lg:mx-auto lg:w-full lg:px-0 lg:py-0 lg:opacity-0">
            <h2 class="text-sm font-bold uppercase tracking-widest text-content lg:sr-only">À propos</h2>
        </div>
        <div>
            <p>
                {%- for segment in about_segments -%}
                    {%- if segment.highlighted -%}
                        <span class="text-brand-fg">{{ segment.text }}</span>
                    {%- else -%}
                        {{ segment.text }}
                    {%- endif -%}
                {%- endfor -%}
            </p>
        </div>
    </section>
{% endif %}
