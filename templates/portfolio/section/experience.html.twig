<section id="experience" class="mb-16 scroll-mt-16 md:mb-24 lg:mb-36 lg:scroll-mt-24">
    <twig:SectionHeader title="Expérience" />
    <ol>
        {% for experience in experiences %}
            <li class="mb-12">
                <div class="lg:flex lg:justify-between lg:gap-1">
                    <header class="sm:col-span-2 lg:w-1/5 lg:flex-col">
                        {{ experience.startDate|date('M Y') }}
                        -
                        {{ experience.endDate ? experience.endDate|date('M Y') : 'maintenant' }}
                    </header>
                    <div class="sm:col-span-6 lg:w-4/5 lg:flex-col">
                        <h3 class="font-medium leading-snug text-content-high">{{ experience.position }}
                            -
                            {{ experience.company }}</h3>
                        <p class="mt-2 text-sm leading-normal">
                            {{ experience.description|raw }}
                        </p>
                        <ul class="mt-2 flex flex-wrap">
                            {% for tag in experience.tags.tags %}
                                <li class="mr-1.5 mt-2">
                                    <twig:Badge variant="outline" class="border-2 border-brand-light px-3 py-1 leading-5 text-brand-fg">{{ tag }}</twig:Badge>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ol>
</section>
