{% extends 'base.html.twig' %}

{% block title %}Connexion — Clément BOUDINEL{% endblock %}

{% block body %}
    <section class="align-middle">
        <div class="flex flex-col items-center justify-center px-2 py-8 mx-auto md:h-screen lg:py-0">
            <div class="w-full bg-panel border border-panel-line rounded-lg shadow-sm md:mt-0 sm:max-w-md xl:p-0">
                <div class="p-6 space-y-4 md:space-y-6 sm:p-8">
                    <h1 class="text-xl font-bold leading-tight tracking-tight text-content-max md:text-2xl">
                        Sign in to your account
                    </h1>
                    <form class="space-y-4 md:space-y-6" method="post">
                        {% if error %}
                            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                        {% endif %}
                        <div>
                            <label for="username" class="block mb-2 text-sm font-medium text-content-max">Username</label>
                            <input type="text" value="{{ last_username }}" name="_username" id="username" class="bg-field border border-field-line text-field-content placeholder-field-hint sm:text-sm rounded-lg focus:ring-accent-fg focus:border-accent-fg block w-full p-2.5" autocomplete="username" required autofocus>
                        </div>

                        <div>
                            <label for="password" class="block mb-2 text-sm font-medium text-content-max">Password</label>
                            <input type="password" name="_password" id="password" class="bg-field border border-field-line text-field-content placeholder-field-hint sm:text-sm rounded-lg focus:ring-accent-fg focus:border-accent-fg block w-full p-2.5" autocomplete="current-password" required>
                        </div>

                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                        <button class="w-full text-accent-on bg-accent-strong hover:bg-accent focus:ring-4 focus:outline-hidden focus:ring-accent-fg focus:ring-offset-2 focus:ring-offset-panel font-medium rounded-lg text-sm px-5 py-2.5 text-center" type="submit">
                            Sign in
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
