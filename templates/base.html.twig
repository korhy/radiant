<!doctype html>
<html class="scroll-smooth bg-surface/75" lang="fr">

<head>
    <meta charset="utf-8">
    {% block viewport %}
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% endblock %}
    {% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    {% endblock %}
    <title>{% block title %}Clément BOUDINEL{% endblock %}</title>
    <link rel="icon" href="{{ asset('images/favicon.svg') }}" />
</head>

<body class="antialiased text-content-low bg-gradient-to-tr from-canvas from-50% to-canvas-end {% block body_class %}{% endblock %}">
    {# read and display all flash messages #}
    {% for label, messages in app.flashes %}
    {% for message in messages %}
    <div class="bg-notice text-center py-4 lg:px-4">
        <div class="p-2 bg-notice-raised items-center text-notice-content leading-none lg:rounded-full flex lg:inline-flex"
            role="alert">
            <span class="flex rounded-full bg-notice-accent uppercase px-2 py-1 text-xs font-bold mr-3">{{ label }}</span>
            <span class="font-semibold mr-2 text-left flex-auto">{{ message }}</span>
        </div>
    </div>
    {% endfor %}
    {% endfor %}

    <div class="{% block layout_wrapper_class %}mx-auto min-h-screen max-w-screen-xl px-6 py-12 font-sans md:px-12 md:py-20 lg:px-24 lg:py-0{% endblock %}">
        {# Exactly one <main> per page. A page that must place the landmark
           itself — the portfolio, whose sidebar has to stay a banner outside
           it — overrides `main` instead of `body`. #}
        {% block main %}
        <main>
            {% block body %}{% endblock %}
        </main>
        {% endblock %}
    </div>
    <footer class="{% block footer_class %}{% endblock %} mx-auto max-w-screen-xl px-6 py-6 md:px-12 lg:px-24 border-t border-line-subtle">
        <p class="text-xs text-content-min">
            © {{ 'now'|date('Y') }} Clément BOUDINEL —
            <a href="{{ path('legal') }}" class="hover:text-brand-fg transition-colors">Mentions légales</a>
        </p>
    </footer>
    {% block javascripts %}
    {{ encore_entry_script_tags('app') }}
    {% endblock %}
</body>

</html>
