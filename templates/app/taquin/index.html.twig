{# templates/app/taquin/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Taquin — Clément BOUDINEL{% endblock %}
{% block body_class %}overflow-hidden{% endblock %}

{% block body %}
<div class="flex justify-center items-start md:items-center min-h-screen pt-16 md:-pt-2">
    <div data-controller="taquin"
        class="relative flex flex-col items-center gap-6 bg-surface-raised p-8 rounded-2xl shadow-2xl w-fit">

        <div data-taquin-target="grid">
            <h1
                class="text-content-max text-2xl font-bold tracking-wide mb-4 text-center flex items-center gap-2 justify-center">
                <span class="w-7 h-7">{{ include('components/_icon_taquin.html.twig') }}</span>
                Taquin
                <twig:InfoDisclosure class="inline-block font-normal">
                    <twig:InfoDisclosure:Trigger label="Règles du jeu" class="cursor-help text-base text-content-low hover:text-content-max" />
                    <twig:InfoDisclosure:Panel class="left-1/2 top-full mt-2 w-64 -translate-x-1/2 rounded-lg bg-surface-inset p-3 text-sm font-normal text-content-mid shadow-xl">
                        <p>L'objectif est de remettre les tuiles dans l'ordre en les déplaçant une par une
                            via la case vide. Au clavier : les flèches déplacent le focus, Entrée fait glisser
                            la tuile.
                        </p>
                    </twig:InfoDisclosure:Panel>
                </twig:InfoDisclosure>
            </h1>
            <div class="grid grid-cols-4 gap-2" role="group" aria-label="Grille du taquin"
                data-action="click->taquin#move keydown->taquin#navigate">
                {% for i in 1..15 %}
                <button type="button" class="tile" aria-label="Tuile {{ i }}">{{ i }}</button>
                {% endfor %}
                <button type="button" class="empty w-16 h-16 bg-tile-empty rounded-lg" aria-label="Case vide"
                    disabled></button>
            </div>
        </div>

        {# Without this region, moves are silent to a screen reader. #}
        <p data-taquin-target="status" role="status" aria-live="polite" class="sr-only"></p>

        <div class="grid">
            <div class="grid grid-cols-2 gap-2">
                <a href="{{ path('homepage') }}"
                    class="bg-surface-muted hover:bg-surface-inset text-content-max font-bold px-6 py-2 rounded-full transition-colors cursor-pointer text-center">
                    Retour
                </a>
                <button data-action="click->taquin#shuffle"
                    class="bg-brand hover:bg-brand-strong text-brand-on font-bold px-6 py-2 rounded-full transition-colors cursor-pointer">
                    Mélanger
                </button>

            </div>
        </div>

        <div data-taquin-target="winOverlay"
            class="hidden absolute inset-0 bg-surface/90 backdrop-blur-sm rounded-2xl flex flex-col items-center justify-center gap-4">
            <p class="text-5xl" aria-hidden="true">🎉</p>
            <p class="text-content-max text-2xl font-bold tracking-wide">Bravo !</p>
            <button data-taquin-target="replay" data-action="click->taquin#replay"
                class="px-6 py-2 bg-brand hover:bg-brand-strong text-brand-on font-semibold rounded-full transition-colors cursor-pointer">
                Rejouer
            </button>
        </div>
    </div>

</div>

{{ include('components/_app_detail_drawer.html.twig') }}
{% endblock %}
