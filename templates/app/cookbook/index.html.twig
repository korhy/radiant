{# templates/app/cookbook/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Cookbook — Clément BOUDINEL{% endblock %}

{% block body %}
<div class="min-h-screen pt-4 pb-10 sm:py-10 px-4">
    <div class="max-w-4xl mx-auto flex flex-col gap-6">
        {# Navbar #}
        {{ include('app/cookbook/navbar.html.twig') }}

        {# Breadcrumb #}
        {{ include('app/cookbook/breadcrumb.html.twig', {breadcrumbs: [
        {label: 'Portfolio', path: path('homepage')},
        {label: 'Cookbook', path: path('cookbook')},
        ]}) }}

        {# Filters & sorts #}
        <div data-controller="cookbook" data-cookbook-next-page-value="2"
            data-cookbook-recipes-url-value="{{ path('cookbook_recipes_json') }}"
            data-cookbook-unavailable-label-value="Recettes momentanément indisponibles"
            data-cookbook-categories-value="{{ categories|json_encode }}">

            <div class="flex flex-col sm:flex-row gap-3">
                <input data-cookbook-target="searchInput" type="search" placeholder="Rechercher une recette…"
                    class="flex-1 bg-surface-raised border border-line-control rounded-xl px-4 py-2 text-sm text-content-max placeholder-content-min focus:outline-hidden focus:border-brand-fg transition-colors">

                <div class="relative">
                    {# The visible option text is not an accessible name: without this
                       label the select is announced as "menu", nothing more. #}
                    <select data-cookbook-target="categorySelect" aria-label="Filtrer par catégorie"
                        class="w-full bg-surface-raised border border-line-control rounded-xl px-4 pr-10 py-2 text-sm text-content-max focus:outline-hidden focus:border-brand-fg transition-colors appearance-none">
                        <option value="">Toutes les catégories</option>
                        {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.name }}</option>
                        {% endfor %}
                    </select>
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.2"
                        stroke="currentColor" class="pointer-events-none h-4 w-4 absolute top-1/2 right-3 -translate-y-1/2 text-content-low">
                        <path stroke-linecap="round" stroke-linejoin="round"
                            d="M8.25 15 12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9" />
                    </svg>
                </div>
            </div>

            <div class="flex flex-wrap gap-2 mt-3">
                <span class="text-content-min text-xs self-center">Trier par :</span>
                <button data-cookbook-target="sortBtn" data-sort="title" data-action="cookbook#sort"
                    class="px-3 py-1 rounded-full text-xs border border-line-control text-content-low hover:border-brand-fg hover:text-brand-fg-em transition-colors">
                    Titre
                </button>
                <button data-cookbook-target="sortBtn" data-sort="createdAt" data-action="cookbook#sort"
                    class="px-3 py-1 rounded-full text-xs border border-line-control text-content-low hover:border-brand-fg hover:text-brand-fg-em transition-colors">
                    Date
                </button>
                <button data-cookbook-target="sortBtn" data-sort="duration" data-action="cookbook#sort"
                    class="px-3 py-1 rounded-full text-xs border border-line-control text-content-low hover:border-brand-fg hover:text-brand-fg-em transition-colors">
                    Durée
                </button>
            </div>

            {# Recipe cards #}
            <div id="recipe-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
                {% if recipes is not empty %}
                    {{ include('app/cookbook/_recipe_grid_items.html.twig') }}
                {% elseif apiUnavailable %}
                    {{ include('app/cookbook/_recipe_grid_state.html.twig', {
                        message: "L'API Cookbook est momentanément injoignable.",
                        hint: "Les recettes viennent d'un service externe ; le reste du portfolio reste consultable.",
                    }) }}
                {% else %}
                    {{ include('app/cookbook/_recipe_grid_state.html.twig', {
                        message: "Aucune recette pour l'instant.",
                    }) }}
                {% endif %}
            </div>

            {# Present from the first render, and empty: an announcement region
               added later is unevenly reported by assistive technology. #}
            <p data-cookbook-target="announcement" role="status" class="sr-only"></p>

            {# Always rendered, hidden when there is nothing more to load: the
               controller toggles it instead of rebuilding it, which keeps every
               piece of visible text in this template. #}
            <div data-cookbook-target="loadMoreContainer"
                class="flex justify-center mt-6{{ hasNextPage ? '' : ' hidden' }}">
                <span data-cookbook-target="button" class="text-content-min text-sm animate-pulse">
                    Chargement…
                </span>
            </div>

        </div>{# /data-controller #}

    </div>
</div>

{{ include('components/_app_detail_drawer.html.twig') }}
{% endblock %}
