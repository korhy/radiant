{# An empty state for the recipe grid, parameterised by its message: the
   catalogue being empty and a search matching nothing are not the same thing.
   Served by both render paths, so it can never drift again.

   Variables: message (required), hint (optional). #}
<twig:Empty class="col-span-full bg-surface-raised rounded-2xl p-12">
    <twig:Empty:Media class="w-12 h-12 text-content-min">
        {{ include('components/_icon_cookbook.html.twig') }}
    </twig:Empty:Media>
    <twig:Empty:Header>
        <twig:Empty:Description class="text-content-low">{{ message }}</twig:Empty:Description>
        {% if hint is defined and hint %}
            <twig:Empty:Description class="text-content-min text-sm">{{ hint }}</twig:Empty:Description>
        {% endif %}
    </twig:Empty:Header>
</twig:Empty>
