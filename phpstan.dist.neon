parameters:
    level: 5
    paths:
        - bin/
        - config/
        - public/
        - src/
        - tests/
    excludePaths:
        # (?) : le fichier n'est plus versionné, il n'existe donc pas dans un
        # checkout neuf. Sans ce marqueur, PHPStan échoue sur un chemin absent.
        - config/reference.php (?)
    ignoreErrors:
        - identifier: property.unusedType